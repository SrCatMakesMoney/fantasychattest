MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
JWT_SECRET=tu-clave-secreta-aqui

# Cloudinary (para subir imagenes/videos/audio)
# 1. Crea cuenta gratis en https://cloudinary.com
# 2. Ve a Settings > Upload > Upload Presets > Add Upload Preset > Signing Mode: Unsigned
# 3. Copia tu Cloud Name y el nombre del preset
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=tu_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=tu_preset_unsigned
